C_CYAN = "\033[38;2;128;206;214m"       # Aqua Teal (#80CED6)
C_WHITE = "\033[38;2;253;251;247m"      # Soft White (#FDFBF7)
C_MUTED = "\033[38;2;180;170;185m"      # Lavender Muted (#B4AAB9)

BANNER = f"""{C_PINK}
    ⠀⠀⠀⠀⠀⠀⠀⠀⠀⣀⣠⡤⠤⠤⣄⣀⣰⠲⣄⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
    ⠀⠀⠀⠀⠀⢀⠤⠒⠉⠳⢄⠱⡀⠀⠀⢨⠇⠀⡌⢳⡀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
    ⠀⠀⠀⣠⣞⡁⠀⢀⣀⡀⠀⠡⣱⠴⠊⠹⠀⠀⢹⠀⣷⢤⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
    ⠀⢀⡜⠁⣀⡀⠀⠄⠀⠈⣁⡾⠁⠀⠀⠀⠀⠀⠸⠀⢹⠀⢳⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
    ⠀⡾⠒⠉⢀⣀⣀⣀⠀⠀⡞⠀⠀⠀⠀⠀⠀⠀⠀⠀⣎⠀⠀⣧⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
    ⢀⡇⠀⡰⠋⠀⠀⢸⣭⡛⠀⠀⠀⠀⠀⠀⠀⡀⠀⠀⡏⠀⠀⢻⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
    ⠘⡇⠀⡇⠀⠀⠀⣸⣏⢳⠀⠀⠀⢀⣀⠤⠴⠿⠂⣸⠀⠀⣘⣾⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
    ⠀⡄⠘⣆⠀⠘⠛⢻⣿⡇⠀⠰⠋⠀⠀⠀⠀⣠⠃⠀⢠⣿⢹⠀⠀⠀⠀⠀⠀⠀⢀⣠⠤⠤⠤⢄⣀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
    ⠀⠀⠙⣄⠈⠳⣄⠀⢈⡿⠃⠀⠀⠀⠀⠀⠀⡴⠃⠀⢠⢋⠇⡼⠀⠀⠀⠀⢀⡴⠊⠁⠀⠀⠀⠀⠀⠀⠙⢦⡀⠀⠀⠀⠀⠀⠀⠀
    ⠀⠀⠀⠈⠳⢄⡈⠓⢬⡓⠤⣼⣀⣀⣤⡴⡞⠀⠀⠠⢃⠎⢀⡗⢊⣉⣉⣙⣷⣖⣊⡉⠉⠁⠒⠢⡀⠀⠀⠀⠱⡀⠀⠀⠀⠀⠀⠀
    ⠀⠀⠀⠀⠀⠀⠉⠲⣄⠈⠳⢄⠀⠀⠀⡟⠀⠀⡰⠁⡜⠀⢸⠙⢷⡔⠚⣉⡭⣿⡀⠈⠑⣄⠀⠀⠈⢢⡀⠀⠀⢱⠀⠀⠀⠀⠀⠀
    ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠑⢦⠀⠑⢄⢠⡇⠀⡰⠁⢠⠁⢀⡆⠀⠀⢈⣏⣤⣶⣿⠇⠀⠀⠘⡄⠀⠀⠀⢡⠀⠀⢨⡄⠀⠀⠀⠀⠀
    ⠀⠀⠀⠀⠀⠀⢀⣠⣄⡀⠀⢳⡄⠈⢿⡇⠀⡅⠀⠸⠀⣼⣀⣀⣠⣾⣵⠟⠉⣹⠀⠀⠀⠀⢻⠀⠀⠀⢸⠀⠀⡼⡇⠀⠀⠀⠀⠀
    ⠀⠀⠀⠀⠀⠀⡏⢸⡉⠈⢁⡜⢹⠀⢸⡿⡀⡄⠀⡇⠀⣇⠠⣭⣽⣶⠋⠀⢠⠇⠀⠀⠀⠀⡟⠀⠀⢀⠎⠀⡰⠁⡇⠀⠀⠀⠀⠀
    ⠀⠀⠀⠀⠀⠀⠳⣄⠉⠓⠉⠀⢀⡧⠊⠀⠹⣷⠀⠸⡀⠘⢆⣿⣿⡟⢇⠀⠘⠙⣆⠀⠀⣸⠁⠀⢀⠎⢀⡔⠁⢰⠀⠀⠀⠀⠀⠀
    ⠀⠀⠀⠀⠀⠀⠀⠀⠉⠀⠀⠈⠁⠀⠀⠀⠀⡏⠙⢦⣵⣄⠀⢉⣩⡇⠸⡄⠀⠀⠸⡀⣴⠃⠀⡠⢃⡴⠋⠀⣠⠏⠀⠀⠀⠀⠀⠀
    ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢠⠃⠀⠀⠇⠉⠉⠉⡇⡇⠀⡇⠀⠀⠀⡿⠃⠀⡜⡡⠋⢀⡠⠞⠁⠀⠀⠀⠀⠀⠀⠀
    ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⡜⠀⠀⣸⠀⠀⠀⠀⣿⠁⢠⠃⠀⠀⢰⠇⠀⡼⡞⠀⡞⠁⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀
    ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⣰⠁⠀⢀⠇⠀⠀⠀⢸⠏⠀⡜⠀⠀⠀⠘⣧⡀⡇⢧⠀⠉⠑⠒⠀⢉⣉⣉⣉⡉⠓⢦⡀
    ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⢠⠃⠀⢀⡞⠀⠀⠀⠀⣸⠤⢴⠁⠀⠀⠀⢀⡏⠉⠓⠒⠷⠶⠒⠚⠉⠁⠀⠀⠀⠀⠙⢦⣹
    ⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠈⠓⠒⠺⠤⠤⠤⠤⠴⠋⠀⠈⠓⠒⠒⠊⠉⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠤⠴⠛⠉
{C_RESET}
  {C_BOLD}{C_PINK}Arch Linux: Fluttershy Edition (Live & Installer){C_RESET}
  {C_MUTED}───────────────────────────────────────────────────────────────────{C_RESET}
"""

def clear():
    os.system("clear" if os.name != "nt" else "cls")

def show_menu():
    clear()
    print(BANNER)
    print(f"{C_BOLD}{C_PINK}🌸 Выбери действие (нажми цифру и Enter):{C_RESET}\n")
    print(f"  {C_CYAN}[ 1 ]{C_RESET} {C_BOLD}✨ Запустить портативный рабочий стол (Live Workspace){C_RESET}")
    print(f"        {C_MUTED}Система уже готова! Открывает Fastfetch, системный монитор и TUI-панель без установки на диск.{C_RESET}\n")
    print(f"  {C_CYAN}[ 2 ]{C_RESET} {C_BOLD}🚀 Установить Arch Linux Fluttershy Edition на диск (5 ГБ+){C_RESET}")
    print(f"        {C_MUTED}Простой пошаговый мастер: сам разметит диск, установит систему и настроит загрузчик.{C_RESET}\n")
    print(f"  {C_CYAN}[ 3 ]{C_RESET} {C_BOLD}🌐 Настроить Wi-Fi / Сеть (nmtui){C_RESET}")
    print(f"        {C_MUTED}Удобный графический список сетей Wi-Fi для подключения.{C_RESET}\n")
    print(f"  {C_CYAN}[ 4 ]{C_RESET} {C_BOLD}🎨 Переключить тему (Светлая пастель / Тёмный обсидиан){C_RESET}")
    print(f"        {C_MUTED}Мгновенно переключает весь терминал: светлая розовая или тёмная тема.{C_RESET}\n")
    print(f"  {C_CYAN}[ 5 ]{C_RESET} {C_BOLD}📄 Просмотреть палитру и конфиги (Kitty / Alacritty / Ghostty){C_RESET}")
    print(f"        {C_MUTED}Показывает цветовые токены и файлы конфигурации.{C_RESET}\n")
    print(f"  {C_CYAN}[ 6 ]{C_RESET} {C_BOLD}💻 Выйти в командную строку (Zsh){C_RESET}\n")

    try:
        choice = input(f"{C_PINK}Твой выбор [1-6]: {C_RESET}").strip()
    except (EOFError, KeyboardInterrupt):
        print("\n\n...yay! ✿")
        return

    if choice == "1":
        start_live_workspace()
    elif choice == "2":
        start_guided_installer()
    elif choice == "3":
        subprocess.run(["nmtui"])
        show_menu()
    elif choice == "4":
        subprocess.run(["/usr/local/bin/fluttershy-theme", "toggle"])
        input(f"\n{C_MUTED}Тема переключена! Нажми Enter чтобы вернуться в меню...{C_RESET}")
        show_menu()
    elif choice == "5":
        subprocess.run(["python3", "/usr/local/bin/fluttershy-main", "--palette"])
        input(f"\n{C_MUTED}Нажми Enter чтобы вернуться в меню...{C_RESET}")
        show_menu()
    elif choice == "6":
        print(f"\n{C_CREAM}Ты в шелле Arch Linux! Чтобы снова открыть это меню, введи: {C_PINK}menu{C_RESET}\n")
    else:
        show_menu()

def start_live_workspace():
    clear()
    print(f"{C_PINK}{C_BOLD}🌸 Запуск портативного окружения Fluttershy Live...{C_RESET}\n")
    time.sleep(1)
    # Run Fastfetch
    if os.path.exists("/usr/bin/fastfetch"):
        subprocess.run(["fastfetch"])
    else:
        print(BANNER)

    print(f"\n{C_CREAM}Готово! Ты в портативной системе. Всё работает в оперативной памяти.{C_RESET}")
    print(f"Полезные команды:")
    print(f"  {C_CYAN}menu{C_RESET}        - снова открыть графическое меню")
    print(f"  {C_CYAN}install-arch{C_RESET} - запустить установщик на жесткий диск")
    print(f"  {C_CYAN}fastfetch{C_RESET}   - показать информацию о системе")
    print(f"  {C_CYAN}htop{C_RESET}        - посмотреть мониторинг процессов\n")

def start_guided_installer():
    clear()
    installer_path = "/usr/local/bin/fluttershy-install"
    if os.path.exists(installer_path):
        subprocess.run(["bash", installer_path])
    else:
        print(f"{C_PINK}Запуск стандартного интерактивного установщика archinstall...{C_RESET}\n")
        subprocess.run(["archinstall"])
    input(f"\n{C_MUTED}Нажми Enter для возврата в меню...{C_RESET}")
    show_menu()

if __name__ == "__main__":
    show_menu()
