# 🌸 Arch Linux: Fluttershy Edition .bashrc
export PS1="\[\033[38;2;255;182;193m\](✿◠‿◠) \[\033[38;2;128;206;214m\][\u@arch]\[\033[0m\] \[\033[38;2;255;249;230m\]\w\[\033[0m\] \[\033[38;2;255;182;193m\]\$\[\033[0m\] "

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias fluttershy='fastfetch'
alias yay-p='echo "✿ ...yay! ✿"'
